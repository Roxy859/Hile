local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local localPlayer = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- ===== KONFIGURASYON =====
local Config = {
    SilentAim = true,          -- True = bakmadan vur
    RageBot = true,            -- True = ragebot açık
    TriggerBot = true,         -- True = crosshair kafaya gelince otomatik ateş
    Hitchance = 85,            -- %85 isabet şansı (0-100)
    SpreadMultiplier = 0.85,   -- Spread azaltma (1 = normal, 0 = tam isabet)
    VisCheck = true,           -- True = duvar arkası kontrolü açık
    Wallbang = true,           -- True = duvar arkasına da vur
    TargetPart = "Head",       -- Head / HumanoidRootPart / Random
    FOV = 360,                 -- 360 POV
    MaxDistance = 1000,        -- Maksimum mesafe
    AutoShoot = true,          -- TriggerBot için otomatik ateş
}

-- ===== YARDIMCI FONKSİYONLAR =====
local function isAlive(player)
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0 and hum.Parent ~= nil
end

local function getTargetPart(character)
    if Config.TargetPart == "Head" then
        local head = character:FindFirstChild("Head")
        if head then return head end
    elseif Config.TargetPart == "HumanoidRootPart" then
        local root = character:FindFirstChild("HumanoidRootPart")
        if root then return root end
    elseif Config.TargetPart == "Random" then
        local parts = {"Head", "HumanoidRootPart", "UpperTorso", "LowerTorso"}
        for _, partName in ipairs(parts) do
            local part = character:FindFirstChild(partName)
            if part then return part end
        end
    end
    return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
end

-- ===== VISIBLE CHECK + WALLBANG (Duvar Kontrolü) =====
local function isVisible(origin, targetPos)
    if not Config.VisCheck then return true end
    
    local direction = (targetPos - origin).Unit
    local distance = (targetPos - origin).Magnitude
    local ray = Ray.new(origin, direction * distance)
    
    local hit, position = workspace:FindPartOnRayWithIgnoreList(ray, {localPlayer.Character, camera})
    
    if hit then
        local distToTarget = distance
        local distToHit = (position - origin).Magnitude
        
        if distToHit >= distToTarget - 2 then
            return true -- Direk görüş var
        end
        
        -- Wallbang kontrolü
        if Config.Wallbang then
            local hitParent = hit.Parent
            if hitParent then
                -- Oyuncuya ait bir şey değilse duvar/eşya demektir
                local hitPlayer = Players:GetPlayerFromCharacter(hitParent)
                if not hitPlayer then
                    -- Duvar/engel varsa yine de vur (wallbang)
                    -- Penetration kontrolü: material kontrolü yapabilirsin
                    local material = hit.Material
                    if material and material ~= Enum.Material.Water then
                        return true
                    end
                end
            end
        end
        
        return false -- Görüş yok ve wallbang kapalı
    end
    
    return true
end

-- ===== HITCHANCE KONTROLÜ =====
local function checkHitchance()
    if Config.Hitchance >= 100 then return true end
    local random = math.random(1, 100)
    return random <= Config.Hitchance
end

-- ===== SPREAD HESAPLAMA =====
local function applySpread(origin, direction)
    if Config.SpreadMultiplier >= 1 then return direction end
    
    local spreadAngle = (1 - Config.SpreadMultiplier) * 0.05
    local theta = math.random() * 2 * math.pi
    local phi = math.random() * spreadAngle
    
    local right = camera.CFrame.RightVector
    local up = camera.CFrame.UpVector
    
    local newDir = direction + (right * math.cos(theta) + up * math.sin(theta)) * phi
    return newDir.Unit
end

-- ===== EN YAKIN HEDEFİ BUL =====
local function getBestTarget()
    local character = localPlayer.Character
    if not character then return nil, nil end
    
    local origin = camera.CFrame.Position
    local mousePos = UserInputService:GetMouseLocation()
    
    local bestTarget = nil
    local bestPart = nil
    local bestDist = Config.FOV
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and isAlive(player) then
            local targetPart = getTargetPart(player.Character)
            if targetPart then
                local targetPos = targetPart.Position
                local distance = (targetPos - origin).Magnitude
                
                if distance <= Config.MaxDistance then
                    -- Görüş kontrolü (VisCheck + Wallbang)
                    if not Config.VisCheck or isVisible(origin, targetPos) then
                        
                        local screenPoint = camera:WorldToScreenPoint(targetPos)
                        if screenPoint.Z > 0 then
                            local screenPos = Vector2.new(screenPoint.X, screenPoint.Y)
                            local screenDist = (screenPos - mousePos).Magnitude
                            
                            if screenDist <= bestDist then
                                bestDist = screenDist
                                bestTarget = player
                                bestPart = targetPart
                            end
                        else
                            -- 360 POV - ekran dışı hedefler
                            if Config.FOV >= 360 then
                                if distance < bestDist then
                                    bestDist = distance
                                    bestTarget = player
                                    bestPart = targetPart
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    
    return bestTarget, bestPart
end

-- ===== TRIGGERBOT =====
local function triggerBotCheck()
    if not Config.TriggerBot or not Config.AutoShoot then return false end
    
    local character = localPlayer.Character
    if not character then return false end
    
    local mousePos = UserInputService:GetMouseLocation()
    local mouseRay = camera:ScreenPointToRay(mousePos.X, mousePos.Y)
    
    local hit, hitPos = workspace:FindPartOnRay(mouseRay, localPlayer.Character)
    
    if hit then
        local parent = hit.Parent
        if parent then
            local humanoid = parent:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local player = Players:GetPlayerFromCharacter(parent)
                if player and player ~= localPlayer then
                    local head = parent:FindFirstChild("Head")
                    if head and hit == head then
                        return true
                    end
                end
            end
        end
    end
    
    return false
end

-- ===== BULLETHANDLER HOOK (Silent Aim) =====
local function hookBulletHandler()
    local replicatedStorage = game:GetService("ReplicatedStorage")
    local moduleScripts = replicatedStorage:FindFirstChild("ModuleScripts") or replicatedStorage:FindFirstChild("Modules")
    
    if not moduleScripts then
        for _, child in ipairs(replicatedStorage:GetChildren()) do
            if child:IsA("Folder") and (child.Name:lower():find("gun") or child.Name:lower():find("weapon") or child.Name:lower():find("module")) then
                moduleScripts = child
                break
            end
        end
    end
    
    if not moduleScripts then
        warn("[Ragebot] BulletHandler module not found!")
        return false
    end
    
    local bulletHandler = moduleScripts:FindFirstChild("BulletHandler", true)
    if not bulletHandler then
        for _, child in ipairs(moduleScripts:GetDescendants()) do
            if child.Name:lower():find("bullet") or child.Name:lower():find("fire") or child.Name:lower():find("shoot") then
                bulletHandler = child
                break
            end
        end
    end
    
    if not bulletHandler then return false end
    
    local success, module = pcall(function()
        return require(bulletHandler)
    end)
    
    if not success then return false end
    
    local oldFire = module.Fire or module.fire or module.Shoot or module.shoot
    
    if not oldFire then
        for _, name in ipairs({"Fire", "fire", "Shoot", "shoot", "FireBullet", "fireBullet", "SendBullet"}) do
            if module[name] then
                oldFire = module[name]
                break
            end
        end
    end
    
    if not oldFire then
        warn("[Ragebot] Fire function not found!")
        return false
    end
    
    module.Fire = function(...)
        local args = {...}
        local p6 = args[1] or args
        
        if Config.SilentAim or Config.RageBot then
            local target, targetPart = getBestTarget()
            
            if target and targetPart then
                if not checkHitchance() then
                    return oldFire(...)
                end
                
                local origin = p6.Origin or p6.origin or (p6 and p6.Position)
                if not origin and type(p6) == "table" then
                    origin = p6.CFrame and p6.CFrame.Position or camera.CFrame.Position
                end
                
                if origin then
                    local targetPos = targetPart.Position
                    local newDirection = (targetPos - origin).Unit
                    
                    newDirection = applySpread(origin, newDirection)
                    
                    if p6.Direction ~= nil then
                        p6.Direction = newDirection
                    end
                    if p6.direction ~= nil then
                        p6.direction = newDirection
                    end
                    if p6.CFrame then
                        p6.CFrame = CFrame.new(origin, origin + newDirection)
                    end
                end
            end
        end
        
        return oldFire(...)
    end
    
    module.__index = module
    
    return true
end

-- ===== MOUSE BUTTON SIMULATION (TriggerBot) =====
local function simulateMouseClick()
    if not Config.AutoShoot then return end
    
    local virtualInput = game:GetService("VirtualInputManager")
    if virtualInput then
        virtualInput:SendMouseButtonEvent(
            UserInputService:GetMouseLocation().X,
            UserInputService:GetMouseLocation().Y,
            0,
            true,
            game,
            0
        )
        task.wait(0.05)
        virtualInput:SendMouseButtonEvent(
            UserInputService:GetMouseLocation().X,
            UserInputService:GetMouseLocation().Y,
            0,
            false,
            game,
            0
        )
    end
end

-- ===== ANA DÖNGÜ =====
local function init()
    local hooked = hookBulletHandler()
    if not hooked then
        warn("[Ragebot] Trying alternative hook methods...")
    end
    
    RunService.RenderStepped:Connect(function()
        if triggerBotCheck() then
            simulateMouseClick()
        end
    end)
    
    print("[Ragebot] Loaded successfully!")
    print("[Config] SilentAim:", Config.SilentAim)
    print("[Config] RageBot:", Config.RageBot)
    print("[Config] TriggerBot:", Config.TriggerBot)
    print("[Config] Wallbang:", Config.Wallbang)
    print("[Config] VisCheck:", Config.VisCheck)
    print("[Config] Hitchance:", Config.Hitchance .. "%")
    print("[Config] FOV:", Config.FOV .. "°")
end

local success, err = pcall(init)
if not success then
    warn("[Ragebot] Initialization error:", err)
end
